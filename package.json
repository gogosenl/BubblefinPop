{
  "name": "bubblefin-pop",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --offline",
    "start:online": "expo start",
    "ios": "expo start --offline --ios",
    "android": "expo start --offline --android",
    "typecheck": "tsc --noEmit",
    "audit:levels": "node scripts/audit-levels.mjs",
    "audit:runtime": "node scripts/verify-runtime.mjs",
    "audit:audio": "node scripts/audit-audio.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "check": "npm run typecheck && npm run audit:levels && npm run audit:runtime && npm run audit:audio && npm run audit:public"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
