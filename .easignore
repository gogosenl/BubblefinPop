# Dependencies and Expo local state are restored by EAS Build.
node_modules/
.expo/
.expo-shared/
.expo-smoke-test*/
.tmp-expo*/
.git/

# Local build products and temporary working files.
dist/
dist-*/
work/
outputs/
coverage/

# Store screenshots, handoff archives, and generated binaries are not app sources.
*.zip
*.ipa
*.apk
*.aab
*.log

# Local logs and signing credentials must never be uploaded.
npm-debug.log*
*.jks
*.keystore
*.pem
*.cer
*.p8
*.p12
*.key
*.mobileprovision
credentials*.json
service-account*.json
GoogleService-Info.plist
google-services.json
.env
.env.*
!.env.example
.npmrc

# OS/editor metadata.
.DS_Store
Thumbs.db
.vscode/
.idea/
*.orig
